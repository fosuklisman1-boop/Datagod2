[
  {
    "id": "dash-buy-request-prepares-card",
    "context": "dashboard",
    "role": "dealer",
    "userText": "Buy 5GB MTN for 0240000002 from my wallet",
    "stubs": {
      "get_available_packages": { "packages": [{ "network": "MTN", "size": "5GB", "price": 22.5 }] },
      "get_wallet_balance": { "balance": 50 },
      "prepare_wallet_order": { "draft_id": "11111111-1111-4111-8111-111111111111", "display": "MTN 5GB to 0240000002 for GHS 22.50", "expires_at": "2026-01-02T10:05:00Z", "warnings": [] }
    },
    "expect": [
      { "type": "calledTool", "tool": "prepare_wallet_order" },
      { "type": "noSuccessClaim" },
      { "type": "replyMatches", "pattern": "confirm", "flags": "i" }
    ]
  },
