{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/hubtel-callbacks",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/hubtel-status-check",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/hubtel-cs-status-check",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/sync-mtn-status",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync-afa-status/apexprime",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/verify-pending-payments",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/withdrawals-status-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/expire-stale-bot-orders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/reconcile-paystack-refunds",
      "schedule": "*/5 * * * *"
    }
  ]
}
